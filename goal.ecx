console.out("Welcome to Ecliptix!")
Number money = 0
$"ls"

if(1 == 1){
	console.out("hi")
	$"sleep 5"
}

while(true){
	$"clear"

	console.out("Currently, you have", money)
	console.out("[1] Work")
	console.out("[2] Shop")
	console.out("[3] Exit")

	lock String thing = console.ask("> ")

	if(thing == "1"){
		lock Number random = 60
		money = money + random
		console.out("You worked hard and gained", random)
		process.wait(3)
	} else if(thing == "2"){
		console.out("This has not been implemented yet")
		process.wait(3)
	} else if(thing == "3"){
		process.exit(0)
	} else {
		console.out("Invalid input")
		process.wait(3)
	}

}